@page
@model CarRentalSystem.Pages_Bookings.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Booking</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Booking.Car)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Booking.Car.Make)
